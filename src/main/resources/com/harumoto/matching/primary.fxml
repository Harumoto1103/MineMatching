<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import java.net.*?>
<?import java.lang.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox id="startScreen" alignment="CENTER" prefHeight="640.0" prefWidth="360.0" spacing="20.0" styleClass="start-screen" stylesheets="@primary.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.harumoto.matching.PrimaryController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Pane prefHeight="200.0" prefWidth="200.0" styleClass="title-text" stylesheets="@primary.css">
         <children>
            <Text fill="WHITE" layoutX="70.0" layoutY="154.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="title-text-text" text="MATCHING GAME">
               <font>
                  <Font size="20.0" />
               </font>
            </Text>
         </children></Pane>
      <Button id="startGame" fx:id="star" mnemonicParsing="false" onAction="#onStartGameButtonPressed" styleClass="start-game" text="Start Game" textFill="WHITE">
         <stylesheets>
            <URL value="@primary.css" />
         </stylesheets></Button>
      <Pane prefHeight="200.0" prefWidth="200.0">
         <children>
            <Button id="startGame" layoutX="60.0" layoutY="14.0" mnemonicParsing="false" onAction="#onQuitButtonPressed" styleClass="start-game" text="Quit" textFill="WHITE">
               <stylesheets>
                  <URL value="@primary.css" />
               </stylesheets>
            </Button>
         </children></Pane>
   </children>
</VBox>
